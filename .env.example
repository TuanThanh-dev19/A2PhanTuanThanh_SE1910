# Author: Phan Tuan Thanh - CE190595

# Reference only: Spring Boot does not automatically load .env files.
# Export these variables in PowerShell or configure IntelliJ's run environment.
# Replace host with your verified SQL Server hostname; no credentials in this file.
SQLSERVER_HOST=<verified-sql-server-host>
SQLSERVER_PORT=1433
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false

# Windows Authentication: true, leave username/password empty and install the
# matching x64 mssql-jdbc_auth DLL on PATH before starting Maven/Java/IntelliJ.
# SQL Authentication: false, set your authorized username/password locally.
SQLSERVER_INTEGRATED_SECURITY=false
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=

# Required: generate Base64 from at least 32 cryptographically random bytes.
JWT_SECRET=
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Enable once to add missing demo accounts and active/inactive news (no reset).
DEMO_ENABLED=false
DEMO_ADMIN_EMAIL=admin.m3@example.com
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_EMAIL=staff.m3@example.com
DEMO_STAFF_PASSWORD=
